{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hanzo",
  "version": "2.1.178",
  "identifier": "com.hanzo.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    },
    "macOS": {
      "entitlements": null,
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null,
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": []
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "iOS": {
      "minimumSystemVersion": "13.0"
    },
    "android": {
      "minSdkVersion": 24
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Hanzo",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "decorations": true,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "process": {
      "exit": true,
      "relaunch": true
    },
    "os": {
      "all": true
    },
    "dialog": {
      "all": true
    },
    "fs": {
      "all": true,
      "scope": ["$APPDATA", "$APPDATA/**", "$RESOURCE/**"]
    },
    "http": {
      "all": true,
      "scope": ["https://**", "http://**"]
    },
    "notification": {
      "all": true
    },
    "clipboard": {
      "all": true,
      "writeText": true,
      "readText": true
    },
    "globalShortcut": {
      "all": true
    },
    "window": {
      "all": true
    },
    "menu": {
      "all": true
    },
    "tray": {
      "all": true
    }
  }
}