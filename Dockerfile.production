# Multi-stage production build — Next.js standalone output for a small runtime
# image (traces only the server deps actually used, not all of node_modules).

# ── Build stage ─────────────────────────────────────────────
FROM node:20-alpine AS builder
RUN corepack enable && corepack prepare pnpm@10.17.1 --activate
# libc6-compat for glibc-linked prebuilds; python3/make/g++ so native modules
# (better-sqlite3 — the VFS/deployment store) compile a musl binding from source
# when no alpine prebuild exists. Without these the binding is missing and the
# native site-deploy path 500s at runtime ("Could not locate the bindings file").
RUN apk add --no-cache libc6-compat python3 make g++
WORKDIR /app

COPY package.json pnpm-lock.yaml* ./
RUN pnpm install --no-frozen-lockfile

COPY . .

ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production
ENV NODE_OPTIONS="--max-old-space-size=4096"
# NEXT_BUILD_ONLY signals our own code to skip env validation at build time.
ENV NEXT_BUILD_ONLY=true

# Publishable ingest key (pk_…) for @hanzo/event. WITHOUT it, api.hanzo.ai answers
# every LOGGED-OUT pageview with 403 "valid bearer or a resolvable ingest key
# required" — reproduced from a real browser against the live site — so anonymous
# traffic, which is most of it, never reaches hanzo.events at all. The code has
# always read it (components/providers/analytics.tsx); it was simply never
# provisioned.
#
# It must be a BUILD ARG: Next inlines NEXT_PUBLIC_* at build time, so setting it
# on the pod is too late. Safe to ship in the bundle — pk- is ingest-only by
# construction (publishable.go keeps the prefix out of the bearer/principal path),
# so it can write events and cannot read anything.
#
# EVENT_INGEST_KEY is the name in KMS and on the --build-arg; NEXT_PUBLIC_ is added
# here because that prefix is what makes Next inline a var. The prefix is a property
# of this build, so it is applied in this build file and the secret store keeps the
# ONE plain name — the same arrangement hanzo.chat's Vite build uses with VITE_.
ARG EVENT_INGEST_KEY
ENV NEXT_PUBLIC_EVENT_INGEST_KEY=$EVENT_INGEST_KEY
# Gated HERE because this is the one thing every builder passes through. A guard
# in release.yml protects that lane only, and a build from another lane shipped
# hanzo.app keyless after this repo already had a working key — measured: 35
# chunks scanned, none carried it.
#
# Fail closed. An empty key builds, serves and looks correct while cloud files
# every pageview under $public, which this org cannot read, and ingest answers
# 200 either way. Refuse the artifact instead.
RUN case "$EVENT_INGEST_KEY" in \
      pk-*) : ;; \
      '')   echo "EVENT_INGEST_KEY is empty - pass --build-arg EVENT_INGEST_KEY=<pk-...> (KMS deploy/EVENT_INGEST_KEY, env prod)" >&2; exit 1 ;; \
      *)    echo "EVENT_INGEST_KEY is not a publishable key (expected a pk- prefix)" >&2; exit 1 ;; \
    esac

# CI=false so Next generates the clientReferenceManifest (it skips it when
# CI=true, which GitHub Actions sets and leaks into the Docker build).
RUN CI=false pnpm run build && \
    if [ ! -d ".next/standalone" ]; then \
      echo "ERROR: standalone output missing (is output:'standalone' set?)" && exit 1; \
    fi && \
    if ! find .next/server -name '*client-reference-manifest*' 2>/dev/null | head -1 | grep -q .; then \
      echo "ERROR: clientReferenceManifest not generated (CI env leak?)" && exit 1; \
    fi && \
    if [ -z "${NEXT_PUBLIC_EVENT_INGEST_KEY}" ]; then \
      echo "WARNING: NEXT_PUBLIC_EVENT_INGEST_KEY empty — bundle ships unkeyed; logged-out beacons are refused"; \
    elif grep -rqF "${NEXT_PUBLIC_EVENT_INGEST_KEY}" .next/static; then \
      echo "Build OK — ingest key inlined into .next/static, verified"; \
    else \
      echo "ERROR: NEXT_PUBLIC_EVENT_INGEST_KEY was supplied but is NOT present in .next/static."; \
      echo "       Next inlines NEXT_PUBLIC_* at build; a value absent from the client"; \
      echo "       bundle cannot reach the browser. Check that nothing re-declares it"; \
      echo "       as an ARG after the ENV above — a build arg declared after an ENV of"; \
      echo "       the same name shadows it, which is how hanzo.chat 1.0.58 published a"; \
      echo "       bundle with an empty key from a fully green run."; \
      exit 1; \
    fi && \
    echo "Build OK — standalone output verified"

# better-sqlite3 is a native module (the VFS/site-deploy store). Force-compile a
# musl binding (build tools are present above), then overlay the compiled
# better_sqlite3.node into the TRACED standalone package — Next's file-tracing
# copies the JS but drops the .node, so the deploy path 500s at runtime. Uses
# `find` (robust to the exact pnpm dir name) and FAILS LOUD if the binding never
# compiled or the package isn't in the standalone, so a broken deploy can't ship.
RUN set -eux; \
    pnpm rebuild better-sqlite3; \
    SRC="$(find node_modules -type f -name better_sqlite3.node | head -1)"; \
    test -n "$SRC"; \
    PKG="$(find .next/standalone/node_modules -type d -path '*/better-sqlite3' | head -1)"; \
    test -n "$PKG"; \
    mkdir -p "$PKG/build"; \
    cp "$SRC" "$PKG/build/better_sqlite3.node"; \
    ls -la "$PKG/build/better_sqlite3.node"

# ── Runtime stage — minimal ─────────────────────────────────
FROM node:20-alpine AS runner
RUN apk add --no-cache libc6-compat
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# Next standalone: the traced server (server.js + minimal node_modules), plus
# the static assets and public/ it serves.
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
COPY --from=builder /app/public ./public

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD node -e "require('http').get('http://localhost:3000/api/health', (res) => { process.exit(res.statusCode === 200 ? 0 : 1); }).on('error', () => { process.exit(1); })" || exit 1

CMD ["node", "server.js"]
