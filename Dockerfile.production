# Production Dockerfile - Optimized single-stage build
FROM node:20-alpine

# Enable pnpm via corepack
RUN corepack enable && corepack prepare pnpm@10.17.1 --activate

# Install system dependencies
RUN apk add --no-cache libc6-compat

WORKDIR /app

# Copy package files
COPY package.json pnpm-lock.yaml* ./

# Install all dependencies (including dev for build)
RUN pnpm install --no-frozen-lockfile

# Copy application source
COPY . .

# Build Next.js application
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production
ENV NODE_OPTIONS="--max-old-space-size=4096"

# Server Mode wires generated apps to the Hanzo cloud backend (Base, edge
# functions, secrets). Baked at build time because it is a NEXT_PUBLIC_ flag.
ARG NEXT_PUBLIC_SERVER_MODE=true
ENV NEXT_PUBLIC_SERVER_MODE=$NEXT_PUBLIC_SERVER_MODE

# Public path generated apps call to reach their Base backend (builder-origin proxy).
ARG NEXT_PUBLIC_BASE_URL=/api/base
ENV NEXT_PUBLIC_BASE_URL=$NEXT_PUBLIC_BASE_URL

# IMPORTANT: Do NOT set CI=true here. Next.js 15 skips clientReferenceManifest
# generation when CI=true, causing InvariantError at runtime on every request.
# NEXT_BUILD_ONLY signals our own code to skip env validation at build time.
ENV NEXT_BUILD_ONLY=true

# CRITICAL: Explicitly unset CI so Next.js generates clientReferenceManifest.
# GitHub Actions sets CI=true in the runner env which leaks into Docker builds.
# --webpack: Next 16 defaults to Turbopack, but this app's webpack config
# (@hanzo/ui transpile + handlebars/react-resizable-panels shims) needs webpack.
RUN CI=false pnpm run build --webpack && \
    # Verify build artifacts exist
    if [ ! -d ".next" ]; then \
      echo "ERROR: Build failed - .next directory not created" && exit 1; \
    fi && \
    # Verify clientReferenceManifest exists (Next.js 15 skips it when CI=true)
    if ! find .next/server -name '*client-reference-manifest*' 2>/dev/null | head -1 | grep -q .; then \
      echo "ERROR: clientReferenceManifest not generated (CI env leak?)" && exit 1; \
    fi && \
    echo "Build successful - .next directory and manifests verified"

# Skip prune — node_modules already includes only what's needed for runtime

# Runtime configuration
EXPOSE 3000
ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD node -e "require('http').get('http://localhost:3000/api/health', (res) => { process.exit(res.statusCode === 200 ? 0 : 1); }).on('error', () => { process.exit(1); })" || exit 1

# Start production server
CMD ["pnpm", "start"]