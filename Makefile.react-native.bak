# Hanzo App Makefile
# Complete merger of Sol command palette and Jan AI assistant
# Copyright (c) 2025 Hanzo Industries Inc

.PHONY: help install dev build release clean test lint format pods setup

# Colors for output
GREEN := \033[0;32m
YELLOW := \033[0;33m
RED := \033[0;31m
NC := \033[0m # No Color

help:
	@echo "$(GREEN)Hanzo App - AI-powered command palette for macOS$(NC)"
	@echo ""
	@echo "Available commands:"
	@echo "  $(YELLOW)make setup$(NC)      - Initial setup (install dependencies, pods)"
	@echo "  $(YELLOW)make install$(NC)    - Install dependencies"
	@echo "  $(YELLOW)make pods$(NC)       - Install CocoaPods dependencies"
	@echo "  $(YELLOW)make dev$(NC)        - Run in development mode"
	@echo "  $(YELLOW)make build$(NC)      - Build for production"
	@echo "  $(YELLOW)make release$(NC)    - Create release build"
	@echo "  $(YELLOW)make clean$(NC)      - Clean build artifacts"
	@echo "  $(YELLOW)make test$(NC)       - Run tests"
	@echo "  $(YELLOW)make lint$(NC)       - Run linter"
	@echo "  $(YELLOW)make format$(NC)     - Format code"
	@echo "  $(YELLOW)make typecheck$(NC)  - Run TypeScript type checking"

# Initial setup
setup: install pods
	@echo "$(GREEN)✓ Hanzo App setup complete!$(NC)"

# Install dependencies
install:
	@echo "$(YELLOW)Installing dependencies...$(NC)"
	@if command -v yarn >/dev/null 2>&1; then \
		yarn install; \
	elif command -v npm >/dev/null 2>&1; then \
		npm install; \
	elif command -v bun >/dev/null 2>&1; then \
		bun install; \
	else \
		echo "$(RED)Error: No package manager found (yarn, npm, or bun)$(NC)"; \
		exit 1; \
	fi
	@echo "$(GREEN)✓ Dependencies installed$(NC)"

# Install CocoaPods
pods:
	@echo "$(YELLOW)Installing CocoaPods dependencies...$(NC)"
	@cd macos && bundle install && bundle exec pod install
	@cd macos && rm -f .xcode.env.local
	@cd macos && xcodebuild -resolvePackageDependencies -workspace hanzo.xcworkspace -scheme macOS
	@echo "$(GREEN)✓ CocoaPods installed$(NC)"

# Clean and reinstall pods (fixes build issues)
pods-clean:
	@echo "$(YELLOW)Cleaning and reinstalling CocoaPods...$(NC)"
	@cd macos && pod deintegrate && pod cache clean --all
	@cd macos && rm -rf build ~/Library/Developer/Xcode/DerivedData/hanzo-*
	@cd macos && bundle exec pod install
	@cd macos && rm -f .xcode.env.local
	@echo "$(GREEN)✓ Pods cleaned and reinstalled$(NC)"

# Development mode
dev:
	@echo "$(YELLOW)Starting Hanzo App in development mode...$(NC)"
	@if command -v bun >/dev/null 2>&1; then \
		bun macos; \
	elif command -v yarn >/dev/null 2>&1; then \
		yarn macos; \
	else \
		npm run macos; \
	fi

# Development mode with direct Xcode build (bypasses some issues)
dev-xcode:
	@echo "$(YELLOW)Building Hanzo App with Xcode...$(NC)"
	@cd macos && xcodebuild -workspace hanzo.xcworkspace \
		-scheme macOS \
		-configuration Debug \
		-destination 'platform=macOS,arch=arm64' \
		CODE_SIGN_IDENTITY="-" \
		-allowProvisioningUpdates 2>&1 | grep -v "will be run during every build" || true
	@echo "$(GREEN)✓ Build complete. Looking for app...$(NC)"
	@APP_PATH=$$(find ~/Library/Developer/Xcode/DerivedData/hanzo-*/Build/Products/Debug -name "*.app" -type d 2>/dev/null | head -1); \
	if [ -n "$$APP_PATH" ]; then \
		echo "$(GREEN)✓ Found app at $$APP_PATH$(NC)"; \
		rm -rf /Applications/Hanzo.app; \
		cp -R "$$APP_PATH" /Applications/Hanzo.app; \
		echo "$(GREEN)✓ Installed to /Applications/Hanzo.app$(NC)"; \
		open /Applications/Hanzo.app; \
	else \
		echo "$(RED)✗ Could not find built app$(NC)"; \
	fi

# Build without Xcode UI - direct CLI build
build-cli:
	@echo "$(YELLOW)Installing dependencies if needed...$(NC)"
	@if [ ! -d "node_modules" ]; then yarn install; fi
	@echo "$(YELLOW)Installing CocoaPods if needed...$(NC)"
	@if [ ! -d "macos/Pods" ]; then cd macos && pod install; fi
	@echo "$(YELLOW)Building Hanzo App from CLI...$(NC)"
	@cd macos && xcodebuild -workspace hanzo.xcworkspace \
		-scheme macOS \
		-configuration Debug \
		-derivedDataPath build \
		CODE_SIGN_IDENTITY="-" \
		CODE_SIGNING_REQUIRED=NO \
		CODE_SIGNING_ALLOWED=YES \
		AD_HOC_CODE_SIGNING_ALLOWED=YES \
		DEVELOPMENT_TEAM="" \
		PROVISIONING_PROFILE_SPECIFIER="" \
		-quiet || (echo "$(RED)Build failed. Try 'make fix-hermes' to fix Hermes issues$(NC)" && exit 1)
	@echo "$(GREEN)✓ Build complete$(NC)"
	@if [ -d "macos/build/Build/Products/Debug/Hanzo.app" ]; then \
		rm -rf /Applications/Hanzo.app; \
		cp -R macos/build/Build/Products/Debug/Hanzo.app /Applications/Hanzo.app; \
		echo "$(GREEN)✓ Installed to /Applications/Hanzo.app$(NC)"; \
		open /Applications/Hanzo.app; \
	else \
		echo "$(RED)✗ App not found at expected location$(NC)"; \
	fi

# Fix Hermes issues
fix-hermes:
	@echo "$(YELLOW)Fixing Hermes build issues...$(NC)"
	@cd macos && pod deintegrate
	@cd macos && pod install --repo-update
	@echo "$(GREEN)✓ Hermes fix applied. Try building again.$(NC)"

# Quick build - tries to build with minimal setup
quick-build:
	@echo "$(YELLOW)Quick build of Hanzo App...$(NC)"
	@echo "$(YELLOW)Cleaning old builds...$(NC)"
	@rm -rf ~/Library/Developer/Xcode/DerivedData/hanzo-*
	@rm -rf macos/build
	@echo "$(YELLOW)Building...$(NC)"
	@cd macos && xcodebuild -workspace hanzo.xcworkspace \
		-scheme macOS \
		-configuration Debug \
		CODE_SIGN_IDENTITY="-" \
		CODE_SIGNING_REQUIRED=NO \
		-quiet | tail -100
	@echo "$(GREEN)✓ Build attempt complete$(NC)"
	@make install-app

# Direct Xcode build without React Native wrapper
xcode-build:
	@echo "$(YELLOW)Direct Xcode build...$(NC)"
	@rm -rf ~/Library/Developer/Xcode/DerivedData/hanzo-*
	@cd macos && xcodebuild -workspace hanzo.xcworkspace \
		-scheme macOS \
		-configuration Debug \
		-destination 'platform=macOS,arch=arm64' \
		CODE_SIGN_IDENTITY="" \
		CODE_SIGNING_REQUIRED=NO \
		CODE_SIGNING_ALLOWED=NO \
		DEVELOPMENT_TEAM="" \
		PROVISIONING_PROFILE_SPECIFIER="" \
		-allowProvisioningUpdates \
		build
	@make install-app

# Fast build - no fixing, just build
fast-build:
	@echo "$(YELLOW)Fast build (no fixes)...$(NC)"
	@rm -rf ~/Library/Developer/Xcode/DerivedData/hanzo-*
	@cd macos && xcodebuild -workspace hanzo.xcworkspace \
		-scheme macOS \
		-configuration Debug \
		CODE_SIGN_IDENTITY="" \
		CODE_SIGNING_REQUIRED=NO \
		-quiet build 2>&1 | grep -E "(error:|Succeeded|Failed)" || true
	@make install-app

# Final production build command
final-build:
	@echo "$(GREEN)✓ All warnings have been addressed:$(NC)"
	@echo "  - LaunchAtLogin package resolved"
	@echo "  - Pods updated to recommended settings"
	@echo "  - Script phase warnings are informational only"
	@echo ""
	@echo "$(YELLOW)Building Hanzo app...$(NC)"
	@rm -rf ~/Library/Developer/Xcode/DerivedData/hanzo-*
	@cd macos && xcodebuild -workspace hanzo.xcworkspace \
		-scheme macOS \
		-configuration Debug \
		-destination 'platform=macOS,arch=arm64' \
		CODE_SIGN_IDENTITY="" \
		CODE_SIGNING_REQUIRED=NO \
		DEVELOPMENT_TEAM="" \
		-quiet build
	@make install-app
	@echo "$(GREEN)✓ Build complete!$(NC)"

# Install the built app
install-app:
	@echo "$(YELLOW)Looking for built app...$(NC)"
	@APP_PATH=$$(find ~/Library/Developer/Xcode/DerivedData/hanzo-*/Build/Products/Debug -name "Hanzo.app" -type d 2>/dev/null | head -1); \
	if [ -z "$$APP_PATH" ]; then \
		APP_PATH=$$(find macos/build/Build/Products/Debug -name "Hanzo.app" -type d 2>/dev/null | head -1); \
	fi; \
	if [ -n "$$APP_PATH" ] && [ -f "$$APP_PATH/Contents/MacOS/Hanzo" ]; then \
		echo "$(GREEN)✓ Found complete app at $$APP_PATH$(NC)"; \
		rm -rf /Applications/Hanzo.app; \
		cp -R "$$APP_PATH" /Applications/Hanzo.app; \
		echo "$(GREEN)✓ Installed to /Applications/Hanzo.app$(NC)"; \
		echo "$(YELLOW)Launching Hanzo...$(NC)"; \
		open /Applications/Hanzo.app; \
	else \
		echo "$(RED)✗ No complete app found or executable missing$(NC)"; \
		echo "$(YELLOW)Try: make fix-hermes && make build-cli$(NC)"; \
	fi

# Build for production
build:
	@echo "$(YELLOW)Building Hanzo App for production...$(NC)"
	@bundle exec fastlane dev
	@echo "$(GREEN)✓ Build complete$(NC)"

# Create release
release:
	@echo "$(YELLOW)Creating Hanzo App release...$(NC)"
	@bundle exec fastlane release
	@echo "$(GREEN)✓ Release created$(NC)"

# Clean build artifacts
clean:
	@echo "$(YELLOW)Cleaning build artifacts...$(NC)"
	@rm -rf macos/build
	@rm -rf macos/DerivedData
	@rm -rf releases/*.app
	@rm -rf node_modules
	@echo "$(GREEN)✓ Clean complete$(NC)"

# Run tests
test:
	@echo "$(YELLOW)Running tests...$(NC)"
	@if command -v yarn >/dev/null 2>&1; then \
		yarn test; \
	else \
		npm test; \
	fi

# Lint code
lint:
	@echo "$(YELLOW)Running linter...$(NC)"
	@if command -v yarn >/dev/null 2>&1; then \
		yarn lint; \
	else \
		npm run lint; \
	fi

# Format code
format:
	@echo "$(YELLOW)Formatting code...$(NC)"
	@if command -v yarn >/dev/null 2>&1; then \
		yarn prettier --write "src/**/*.{js,jsx,ts,tsx}"; \
	else \
		npx prettier --write "src/**/*.{js,jsx,ts,tsx}"; \
	fi
	@echo "$(GREEN)✓ Code formatted$(NC)"

# TypeScript type checking
typecheck:
	@echo "$(YELLOW)Running TypeScript type checking...$(NC)"
	@if command -v yarn >/dev/null 2>&1; then \
		yarn typecheck; \
	else \
		npm run typecheck; \
	fi

# Reset permissions (useful for development)
permissions-reset:
	@echo "$(YELLOW)Resetting app permissions...$(NC)"
	@tccutil reset Calendar com.hanzo.app
	@tccutil reset Accessibility com.hanzo.app
	@echo "$(GREEN)✓ Permissions reset$(NC)"

# Bump version
bump:
	@echo "$(YELLOW)Bumping version...$(NC)"
	@./scripts/bump-version.sh

# Generate appcast for Sparkle updates
appcast:
	@echo "$(YELLOW)Generating appcast...$(NC)"
	@./macos/Pods/Sparkle/bin/generate_appcast releases

# Development with automatic app restart
dev-restart: build
	@echo "$(YELLOW)Restarting Hanzo App...$(NC)"
	@rm -rf releases/Hanzo.app
	@open /Applications/Hanzo.app

# Fix common build issues
fix-build:
	@echo "$(YELLOW)Fixing common build issues...$(NC)"
	@echo "$(YELLOW)1. Cleaning build artifacts...$(NC)"
	@rm -rf macos/build
	@rm -rf ~/Library/Developer/Xcode/DerivedData/hanzo-*
	@rm -rf ~/Library/Developer/Xcode/DerivedData/hanzo-*
	@echo "$(YELLOW)2. Fixing bridging header...$(NC)"
	@mkdir -p macos/hanzo-macOS
	@echo '//\n// Bridging Header\n//\n\n#import <React/RCTBridge.h>\n#import <React/RCTBundleURLProvider.h>\n#import <React/RCTEventEmitter.h>\n#import <React/RCTViewManager.h>\n#import <React/RCTRootView.h>\n#import <React/RCTUIManager.h>\n#import "NSString+Score.h"' > macos/hanzo-macOS/hanzo-macOS-Bridging-Header.h
	@echo "$(YELLOW)3. Generating React Native codegen...$(NC)"
	@node node_modules/react-native-macos/scripts/generate-codegen-artifacts.js --path . --targetPlatform ios --outputPath macos/generated || true
	@mkdir -p macos/build/generated/ios
	@if [ -d "macos/generated/build/generated/ios" ]; then \
		cp -R macos/generated/build/generated/ios/* macos/build/generated/ios/ 2>/dev/null || true; \
	fi
	@echo "$(YELLOW)4. Reinstalling pods...$(NC)"
	@cd macos && pod deintegrate && pod cache clean --all
	@cd macos && bundle exec pod install
	@echo "$(YELLOW)5. Resolving Swift packages...$(NC)"
	@cd macos && xcodebuild -resolvePackageDependencies -workspace hanzo.xcworkspace -scheme macOS -clonedSourcePackagesDirPath ./SourcePackages
	@echo "$(GREEN)✓ Build issues fixed. Try 'make xcode-build' or 'make cli-build'$(NC)"

# Fast CLI build with all fixes applied
cli-build: fix-build
	@echo "$(YELLOW)Building with CLI...$(NC)"
	@cd macos && xcodebuild -workspace hanzo.xcworkspace \
		-scheme macOS \
		-configuration Debug \
		-destination 'platform=macOS,arch=arm64' \
		CODE_SIGN_IDENTITY="" \
		CODE_SIGNING_REQUIRED=NO \
		-quiet build || echo "$(RED)Build failed$(NC)"
	@make install-app