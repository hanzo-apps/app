# Hanzo AI Build Platform - Production Environment Configuration
# Copy this file to .env.production and fill in your values

# Application
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://hanzo.app
NEXTAUTH_URL=https://hanzo.app
NEXTAUTH_SECRET=your-nextauth-secret-here-generate-with-openssl-rand-base64-32

# Database
DATABASE_URL=postgresql://hanzo:password@postgres:5432/hanzo_build
DB_USER=hanzo
DB_PASSWORD=your-secure-db-password
DB_NAME=hanzo_build

# Redis
REDIS_URL=redis://:your-redis-password@redis:6379
REDIS_PASSWORD=your-redis-password

# Hanzo IAM SSO (hanzo.id) — OIDC issuer per discovery
#   https://hanzo.id/.well-known/openid-configuration
# Server-side (confidential) code->token exchange in app/api/auth/callback.
# Client id is the registered <org>-<app> public client: hanzo-app.
# SECRET: source from KMS at deploy (KMSSecret -> K8s Secret), never commit.
IAM_CLIENT_ID=hanzo-app
IAM_CLIENT_SECRET=your-iam-client-secret
IAM_ENDPOINT=https://hanzo.id

# Client-side IAM (browser PKCE via @hanzo/iam, lib/hanzo/iam.ts). Defaults
# below match production; override only for non-prod issuers. Public client,
# NO secret in the browser (PKCE S256).
NEXT_PUBLIC_HANZO_IAM_URL=https://hanzo.id
NEXT_PUBLIC_HANZO_CLIENT_ID=hanzo-app
NEXT_PUBLIC_HANZO_REDIRECT_URI=https://hanzo.app/auth/callback

# Hanzo Cloud AI — signed-in users' AI runs on api.hanzo.ai/v1 (the unified
# gateway) authenticated by their IAM session JWT; the gateway debits the org
# in the token's `owner` claim (org==tenant). No provider key needed for the
# default path. The direct provider keys below are only optional BYO / guest
# fallbacks.

# Hanzo Commerce (replaces Stripe; commerce.hanzo.ai is the gateway)
HANZO_COMMERCE_API_URL=https://api.hanzo.ai/v1
HANZO_COMMERCE_API_KEY=your-commerce-api-key
HANZO_COMMERCE_WEBHOOK_SECRET=your-commerce-webhook-secret

# AI Providers
OPENAI_API_KEY=sk-your-openai-api-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
TOGETHER_API_KEY=your-together-api-key

# Optional AI Providers
GROQ_API_KEY=your-groq-api-key
REPLICATE_API_TOKEN=your-replicate-token
COHERE_API_KEY=your-cohere-api-key

# Monitoring (Optional)
SENTRY_DSN=your-sentry-dsn
POSTHOG_KEY=your-posthog-key
POSTHOG_HOST=https://app.posthog.com

# Feature Flags
ENABLE_COMMERCE_BILLING=true
ENABLE_USAGE_TRACKING=true
ENABLE_ANALYTICS=true

# Security
ALLOWED_ORIGINS=https://hanzo.app,https://hanzo.ai
RATE_LIMIT_PER_MINUTE=100
MAX_UPLOAD_SIZE=10485760

# Logging
LOG_LEVEL=info
LOG_FORMAT=json